TELEGRAM_TOKEN=your_bot_token_here

# Optional: set these to run in webhook mode on Render instead of polling.
# Render sets PORT automatically; leave it unless you know what you're doing.
# PORT=8443
# WEBHOOK_HOST=https://your-service.onrender.com
# WEBHOOK_PATH=/webhook/your_bot_token_here
# WEBHOOK_URL=https://your-service.onrender.com/webhook/your_bot_token_here
# WEBHOOK_SECRET=choose_a_random_secret_string
